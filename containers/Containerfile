# Runtimes come from uv because no apt repository carries all four.

FROM docker.io/library/debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/src \
    PRE_COMMIT_HOME=/tmp/pre-commit \
    MYPY_CACHE_DIR=/tmp/mypy-cache \
    PYTEST_ADDOPTS="-o cache_dir=/tmp/pytest-cache" \
    PYSCSI_VERSIONS="3.11 3.12 3.13 3.14" \
    PYSCSI_PYTHON=3.11 \
    UV_PYTHON_INSTALL_DIR=/opt/pythons \
    PATH=/opt/venv/3.11/bin:$PATH

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      libiscsi-bin \
      libiscsi7 \
      sg3-utils \
      tgt \
      unzip \
 && rm -rf /var/lib/apt/lists/*

# With the default `master` the layer caches on that literal string, so a
# rebuild reuses whatever was current the first time. CI passes resolved commit
# SHAs; locally, --build-arg or --no-cache refreshes.
ARG SGIO_REF=master
ARG ISCSI_REF=master

# One layer: a purge in a later layer reclaims nothing.
#
# `set -eux`, not an && chain: a chain ending in `|| true`, which the cleanup
# needs, returns 0 for the whole chain when an early command fails. An earlier
# revision shipped with no runtimes that way.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        curl gcc libc6-dev libiscsi-dev pkg-config; \
    curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh; \
    uv python install $PYSCSI_VERSIONS; \
    for v in $PYSCSI_VERSIONS; do \
        uv venv --python "$v" --seed "/opt/venv/$v"; \
        "/opt/venv/$v/bin/pip" install --no-cache-dir -q \
            pytest "setuptools>=77" "setuptools_scm>=8"; \
        "/opt/venv/$v/bin/pip" install --no-cache-dir -q \
            "git+https://github.com/python-scsi/cython-sgio.git@${SGIO_REF}" \
            "git+https://github.com/python-scsi/cython-iscsi.git@${ISCSI_REF}"; \
    done; \
    "/opt/venv/$PYSCSI_PYTHON/bin/pip" install --no-cache-dir -q build mypy pre-commit; \
    for v in $PYSCSI_VERSIONS; do \
        "/opt/venv/$v/bin/python" -c \
            "import sys, iscsi, sgio; \
             from importlib.metadata import version; \
             got = '%d.%d' % sys.version_info[:2]; \
             assert got == '$v', '/opt/venv/$v runs ' + got; \
             print('  python %-5s  cython-sgio %-24s cython-iscsi %s' \
                   % (got, version('cython-sgio'), version('cython-iscsi')))"; \
    done; \
    apt-get purge -y curl gcc libc6-dev libiscsi-dev pkg-config; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /root/.cache /tmp/*; \
    find / -xdev -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true; \
    find /opt/pythons /opt/venv -xdev \
        \( -name 'test' -o -name 'tests' -o -name 'idlelib' -o -name 'turtledemo' \
           -o -name 'tkinter' \) \
        -type d -prune -exec rm -rf {} + 2>/dev/null || true; \
    rm -rf /opt/pythons/*/lib/tcl* /opt/pythons/*/lib/tk* \
           /opt/pythons/*/lib/itcl* /opt/pythons/*/lib/thread* \
           /opt/pythons/*/lib/libtcl*.so /opt/pythons/*/lib/libtk*.so \
           /opt/pythons/*/share/terminfo /opt/pythons/*/share/man \
           /usr/share/doc /usr/share/man /usr/share/locale

# The mount has a foreign uid; without this git rejects it as dubious ownership
# and setuptools_scm and pre-commit break.
RUN git config --global --add safe.directory /src

RUN cat > /usr/local/lib/pyscsi-report.sh <<'REPORT'
PY="/opt/venv/${PYSCSI_PYTHON:-3.11}/bin/python"
[ -x "$PY" ] || { echo "no runtime for PYSCSI_PYTHON=$PYSCSI_PYTHON" >&2; exit 2; }

pass=0
fail=0
skip=0
results=""

run_one() {
    label="$1"
    shift
    echo
    echo "════════════════════════════════════════════════════════════════════"
    echo "  $label"
    echo "  \$ $*"
    echo "════════════════════════════════════════════════════════════════════"
    if "$@" 2>&1; then
        echo "--- PASS: $label"
        pass=$((pass + 1))
        results="${results}  PASS  ${label}\n"
    else
        rc=$?
        echo "--- FAIL: $label (exit $rc)"
        fail=$((fail + 1))
        results="${results}  FAIL  ${label} (exit ${rc})\n"
    fi
}

skip_one() {
    echo
    echo "--- SKIP: $1 ($2)"
    skip=$((skip + 1))
    results="${results}  SKIP  $1 ($2)\n"
}

summarise() {
    echo
    echo "════════════════════════════════════════════════════════════════════"
    echo "  summary${1:+ for $1}"
    echo "════════════════════════════════════════════════════════════════════"
    printf "%b" "$results"
    echo "────────────────────────────────────────────────────────────────────"
    echo "  $pass passed, $fail failed, $skip skipped"
    echo "════════════════════════════════════════════════════════════════════"
}
REPORT

RUN cat > /usr/local/bin/pyscsi-matrix <<'MATRIX' && chmod +x /usr/local/bin/pyscsi-matrix
#!/bin/bash
set -u
cd "${PYSCSI_SRC:-/src}"

rc=0
summary=""
for v in ${PYSCSI_VERSIONS:-3.11 3.12 3.13 3.14}; do
    py="/opt/venv/$v/bin/python"
    [ -x "$py" ] || { summary="${summary}  SKIP  $v (no runtime)\n"; continue; }
    echo
    echo "════════════════════════════════════════════════════════════════════"
    echo "  Python $v -- $("$py" -V 2>&1)"
    echo "════════════════════════════════════════════════════════════════════"
    if "$py" -m pytest "$@"; then
        summary="${summary}  PASS  $v\n"
    else
        summary="${summary}  FAIL  $v (exit $?)\n"
        rc=1
    fi
done

echo
echo "════════════════════════════════════════════════════════════════════"
echo "  matrix summary"
echo "════════════════════════════════════════════════════════════════════"
printf "%b" "$summary"
echo "════════════════════════════════════════════════════════════════════"
exit $rc
MATRIX

RUN cat > /usr/local/bin/pyscsi-tgt-setup <<'SETUP' && chmod +x /usr/local/bin/pyscsi-tgt-setup
#!/bin/bash
set -eu

IQN="${PYSCSI_IQN:-iqn.2026-01.org.pyscsi:test}"
STORE=/var/lib/tgt

mkdir -p "$STORE"

if ! pgrep -x tgtd >/dev/null 2>&1; then
    tgtd >/tmp/tgtd.log 2>&1 &
    for _ in $(seq 1 20); do
        tgtadm --lld iscsi --op show --mode target >/dev/null 2>&1 && break
        sleep 0.5
    done
fi

if tgtadm --lld iscsi --op show --mode target 2>/dev/null | grep -q "$IQN"; then
    echo "target $IQN already configured"
    exit 0
fi

truncate -s 64M "$STORE/disk.img"
truncate -s 64M "$STORE/tape.img"
truncate -s 64M "$STORE/cd.iso"
truncate -s 1M  "$STORE/changer.img"

tgtadm --lld iscsi --op new --mode target --tid 1 -T "$IQN"

tgtadm --lld iscsi --op new --mode logicalunit --tid 1 --lun 1 \
    -b "$STORE/disk.img"

tgtadm --lld iscsi --op new --mode logicalunit --tid 1 --lun 2 \
    -b "$STORE/changer.img" --device-type=changer
tgtadm --lld iscsi --op update --mode logicalunit --tid 1 --lun 2 \
    --params element_type=1,start_address=1,quantity=1
tgtadm --lld iscsi --op update --mode logicalunit --tid 1 --lun 2 \
    --params element_type=2,start_address=10,quantity=8
tgtadm --lld iscsi --op update --mode logicalunit --tid 1 --lun 2 \
    --params element_type=3,start_address=100,quantity=2
tgtadm --lld iscsi --op update --mode logicalunit --tid 1 --lun 2 \
    --params element_type=4,start_address=200,quantity=2

tgtadm --lld iscsi --op new --mode logicalunit --tid 1 --lun 3 \
    -b "$STORE/tape.img" --device-type=tape

tgtadm --lld iscsi --op new --mode logicalunit --tid 1 --lun 4 \
    -b "$STORE/cd.iso" --device-type=cd

tgtadm --lld iscsi --op bind --mode target --tid 1 -I ALL

echo "target $IQN ready:"
echo "  lun 1  disk           iscsi://127.0.0.1/$IQN/1"
echo "  lun 2  media changer  iscsi://127.0.0.1/$IQN/2"
echo "  lun 3  tape           iscsi://127.0.0.1/$IQN/3"
echo "  lun 4  cd/dvd         iscsi://127.0.0.1/$IQN/4"
SETUP

RUN cat > /usr/local/bin/pyscsi-verify-tools <<'VTOOLS' && chmod +x /usr/local/bin/pyscsi-verify-tools
#!/bin/bash
set -u
. /usr/local/lib/pyscsi-report.sh

DEVICE="${1:?usage: pyscsi-verify-tools /dev/sgN}"
cd "${PYSCSI_SRC:-/src}"

DEVTYPE=$("$PY" - "$DEVICE" <<'PY_EOF'
import sys
from pyscsi.pyscsi.scsi import SCSI
from pyscsi.utils import init_device

with SCSI(init_device(sys.argv[1])) as s:
    print(s.inquiry().result["peripheral_device_type"])
PY_EOF
)

echo "════════════════════════════════════════════════════════════════════"
echo "  python-scsi tool verification"
echo "  device      : $DEVICE"
echo "  device type : $DEVTYPE  (0=disk 1=tape 5=cd/dvd 8=changer)"
echo "  python      : $("$PY" -V 2>&1)"
echo "  sgio        : $("$PY" -c 'import sgio; print("available")' 2>&1)"
echo "════════════════════════════════════════════════════════════════════"

run_one "tools/inquiry.py  standard INQUIRY"   "$PY" tools/inquiry.py "$DEVICE"
run_one "tools/inquiry.py  VPD 0x00 supported" "$PY" tools/inquiry.py -p 00 "$DEVICE"
run_one "tools/inquiry.py  VPD 0x83 device id" "$PY" tools/inquiry.py -p 83 "$DEVICE"
run_one "examples/reportluns.py"               "$PY" examples/reportluns.py "$DEVICE"

if [ "$DEVTYPE" = "0" ]; then
    run_one "tools/inquiry.py  VPD 0xb0 block limits"   "$PY" tools/inquiry.py -p b0 "$DEVICE"
    run_one "tools/inquiry.py  VPD 0xb1 block dev char" "$PY" tools/inquiry.py -p b1 "$DEVICE"
    run_one "tools/inquiry.py  VPD 0xb2 provisioning"   "$PY" tools/inquiry.py -p b2 "$DEVICE"
    run_one "examples/readcapacity10.py"                "$PY" examples/readcapacity10.py "$DEVICE"
    run_one "examples/readcapacity16.py"                "$PY" examples/readcapacity16.py "$DEVICE"
    run_one "examples/read16.py  (read-only)"           "$PY" examples/read16.py "$DEVICE"

    # swp.py reads the SWP bit out of the control mode page (0x0A). Ask the
    # device which pages it has first: a device without 0x0A cannot answer,
    # which is a capability gap rather than a tool failure.
    if sg_modes --all "$DEVICE" 2>/dev/null | grep -q ">> Control"; then
        run_one "tools/swp.py  software write protect" "$PY" tools/swp.py "$DEVICE"
    else
        skip_one "tools/swp.py" "device does not implement the control mode page 0x0A"
    fi

    run_one "tools/getlbastatus.py" "$PY" tools/getlbastatus.py "$DEVICE"
else
    skip_one "block device tools" "device type $DEVTYPE is not a disk"
fi

if [ "$DEVTYPE" = "5" ]; then
    run_one "examples/read_disc_information.py" "$PY" examples/read_disc_information.py "$DEVICE"
    run_one "examples/read_cd.py"               "$PY" examples/read_cd.py "$DEVICE"
else
    skip_one "mmc tools" "device type $DEVTYPE is not cd/dvd"
fi

if [ "$DEVTYPE" = "8" ]; then
    run_one "tools/mtx.py status" "$PY" tools/mtx.py -f "$DEVICE" status
else
    skip_one "tools/mtx.py" "device type $DEVTYPE is not a media changer"
fi

run_one "sg3_utils sg_inq (reference)"         sg_inq "$DEVICE"
run_one "sg3_utils sg_readcap (reference)"     sg_readcap "$DEVICE"
run_one "sg3_utils sg_modes --all (reference)" sg_modes --all "$DEVICE"

summarise "$DEVICE"
echo
echo "  A FAIL means the tool did not complete against THIS device, which may"
echo "  be a library fault or a command the device does not implement. Confirm"
echo "  with sg3_utils before concluding anything."
echo "════════════════════════════════════════════════════════════════════"

[ "$fail" -eq 0 ]
VTOOLS

RUN cat > /usr/local/bin/pyscsi-verify-iscsi <<'VISCSI' && chmod +x /usr/local/bin/pyscsi-verify-iscsi
#!/bin/bash
set -u
. /usr/local/lib/pyscsi-report.sh

IQN="${PYSCSI_IQN:-iqn.2026-01.org.pyscsi:test}"
PORTAL="${PYSCSI_PORTAL:-127.0.0.1}"
cd "${PYSCSI_SRC:-/src}"

pyscsi-tgt-setup

echo
echo "════════════════════════════════════════════════════════════════════"
echo "  python-scsi verification over iSCSI"
echo "  portal : $PORTAL"
echo "  target : $IQN"
echo "  python : $("$PY" -V 2>&1)"
echo "  iscsi  : $("$PY" -c 'import iscsi; print("cython-iscsi available")' 2>&1)"
echo "════════════════════════════════════════════════════════════════════"

DISK="iscsi://$PORTAL/$IQN/1"
CHANGER="iscsi://$PORTAL/$IQN/2"
TAPE="iscsi://$PORTAL/$IQN/3"
CDROM="iscsi://$PORTAL/$IQN/4"

run_one "device types over iSCSI" "$PY" - "$DISK" "$CHANGER" "$TAPE" "$CDROM" <<'PY_EOF'
import sys
from pyscsi.pyscsi.scsi import SCSI
from pyscsi.utils import init_device

names = {0: "disk (sbc)", 1: "tape (ssc)", 5: "cd/dvd (mmc)", 8: "changer (smc)"}
for url in sys.argv[1:]:
    with SCSI(init_device(url)) as s:
        r = s.inquiry().result
        dt = r["peripheral_device_type"]
        vendor = bytes(r["t10_vendor_identification"]).decode().strip()
        product = bytes(r["product_identification"]).decode().strip()
        print(f"  lun {url.rsplit('/', 1)[1]}  type={dt:2d} {names.get(dt, '?'):14s} "
              f"{vendor} {product}")
PY_EOF

run_one "disk    tools/inquiry.py"           "$PY" tools/inquiry.py "$DISK"
run_one "disk    examples/readcapacity10.py" "$PY" examples/readcapacity10.py "$DISK"
run_one "disk    examples/readcapacity16.py" "$PY" examples/readcapacity16.py "$DISK"
run_one "disk    examples/reportluns.py"     "$PY" examples/reportluns.py "$DISK"

run_one "changer tools/inquiry.py"           "$PY" tools/inquiry.py "$CHANGER"
run_one "changer tools/mtx.py status"        "$PY" tools/mtx.py -f "$CHANGER" status

run_one "tape    tools/inquiry.py"           "$PY" tools/inquiry.py "$TAPE"

run_one "cd      tools/inquiry.py"           "$PY" tools/inquiry.py "$CDROM"
run_one "cd      examples/read_disc_information.py" \
    "$PY" examples/read_disc_information.py "$CDROM"

run_one "reference iscsi-ls" iscsi-ls -s "iscsi://$PORTAL"

summarise
[ "$fail" -eq 0 ]
VISCSI

WORKDIR /src

CMD ["pytest", "-vv"]

# Last because a label invalidates every layer below it.
LABEL org.opencontainers.image.title="python-scsi dev environment" \
      org.opencontainers.image.description="Python 3.11-3.14, both SCSI transports, sg3_utils and tgt" \
      org.opencontainers.image.source="https://github.com/python-scsi/python-scsi" \
      org.opencontainers.image.licenses="MIT"
